@startuml SOC_Network_Architecture

!theme spacelab
skinparam ArrowColor #2C3E50
skinparam Linetype polyline
skinparam roundcorner 5

' Define specialized icons for enterprise tools
sprite $wazuh [16x16/16] {
0000000000000000
0023444444432000
03DDEEEEEEDD3000
04DDEEEEEEDD4000
04DDEEEEEEDD4000
03DDEEEEEEDD3000
023444444432000
0000000000000000
}

header <font color=red>CONFIDENTIAL</font> | Network Architecture Diagram
title Security Operations Center (SOC) Logical Infrastructure

' --- Entry Point ---
cloud "Internet" as internet #E8F8FF {
}

' --- Entry Level Infrastructure ---
rectangle "Security Boundaries" as boundaries <<Boundary>> #EEEEEE {
    
    rectangle "AWS Cloud" as aws #FFF9F9 {
        component "(CloudTrail, IAM)" as awsservices <<Cloud Service>>
    }

    rectangle "VMware Workstation Pro" as vmware #FDFDFF {
        component "Host Machine" as host <<Physical>>
        rectangle "Virtual LAN" as vlan #E6F3FF {
            // Internal network bridge
        }
    }
}

' --- Logical Data Flow from Internet ---
internet -down- boundaries

boundaries -[hidden]down- endpoints

' --- Client & Analysis Endpoints ---
rectangle "Endpoints" as endpoints <<Endpoints>> #FBFBFF {
    node "SOC-01" as soc01 {
        [Ubuntu Desktop]
    }

    node "WIN11-CLIENT" as win11 {
        [Windows 11 Home]
    }

    node "KALI-ATTACK" as kali {
        [Kali Linux]
    }
}

' Connect the upper layers to the main VLAN trunk
aws -down- vlan
vlan -down- endpoints
vlan -[hidden]left- soc01
vlan -[hidden]left- win11
vlan -[hidden]left- kali

endpoints -[hidden]down- socstack

' --- The SOC Stack ---
rectangle "SOC Infrastructure" as socstack #EDF9ED {
    component "<$wazuh>\n Wazuh Manager" as wazuh <<Manager>>
    component "OpenSearch\n (OS)" as opensearch <<Database>>
    component "Dashboards\n (OSD)" as dashboards <<Visualization>>
    component "Suricata" as suricata <<IDS>>
    component "Zeek" as zeek <<NSM>>
    component "Greenbone" as greenbone <<Vulnerability>>
}

' Logical connections (Left-to-Right) and flows
soc01 -down- socstack
wazuh -right-> opensearch : Indexes Security Data
opensearch -right-> dashboards : Visualizes Data
suricata -up-> wazuh : Sends Alerts
zeek -up-> wazuh : Sends Logs
greenbone -right-> wazuh : Feeds Vulnerability Reports

footer Generated by Draw.io Conversion to PlantUML

@enduml